# Supply the confirmed public HTTPS origin (no path, port, query or fragment).
# Keep indexing disabled on previews; enable only after launch details are verified.
NEXT_PUBLIC_SITE_URL=
SITE_ALLOW_INDEXING=false
# Optional override. The client's WhatsApp number is set in src/content/business.ts.
# Verified international digits, including country code. No + or spaces.
TERRA_WHATSAPP_NUMBER=

# Dedicated TERRA Supabase project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudinary credentials are server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional anonymous UI conversion hooks; no analytics provider or network requests.
# Subscribe to `abgardening:conversion` only after choosing your privacy/consent setup.
# This public flag is baked into the client build. Disabled by default.
NEXT_PUBLIC_CONVERSION_EVENTS_ENABLED=false
